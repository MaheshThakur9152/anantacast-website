---
import Layout from '../layouts/Layout.astro';
import { 
  DraftingCompass, 
  Flame, 
  Cog, 
  ThermometerSun, 
  Disc, 
  CircleGauge, 
  Microscope, 
  Wrench, 
  Boxes,
  Users,
  ShieldCheck,
  Factory
} from 'lucide-astro';
import copy from '../data/copy';

const values = [
  {
    title: copy['about-val-1-title'],
    tagline: copy['about-val-1-tag'],
    description: copy['about-val-1-desc']
  },
  {
    title: copy['about-val-2-title'],
    tagline: copy['about-val-2-tag'],
    description: copy['about-val-2-desc']
  },
  {
    title: copy['about-val-3-title'],
    tagline: copy['about-val-3-tag'],
    description: copy['about-val-3-desc']
  }
];

const capabilities = [
  {
    icon: DraftingCompass,
    title: copy['about-wwd-card-1-title'],
    description: copy['about-wwd-card-1-desc']
  },
  {
    icon: Flame,
    title: copy['about-wwd-card-2-title'],
    description: copy['about-wwd-card-2-desc']
  },
  {
    icon: Cog,
    title: copy['about-wwd-card-3-title'],
    description: copy['about-wwd-card-3-desc']
  },
  {
    icon: ThermometerSun,
    title: copy['about-wwd-card-4-title'],
    description: copy['about-wwd-card-4-desc']
  },
  {
    icon: Disc,
    title: copy['about-wwd-card-5-title'],
    description: copy['about-wwd-card-5-desc']
  },
  {
    icon: CircleGauge,
    title: copy['about-wwd-card-6-title'],
    description: copy['about-wwd-card-6-desc']
  },
  {
    icon: Microscope,
    title: copy['about-wwd-card-7-title'],
    description: copy['about-wwd-card-7-desc']
  },
  {
    icon: Wrench,
    title: copy['about-wwd-card-8-title'],
    description: copy['about-wwd-card-8-desc']
  },
  {
    icon: Boxes,
    title: copy['about-wwd-card-9-title'],
    description: copy['about-wwd-card-9-desc']
  }
];

const whyUsCards = [
  {
    title: copy['about-wcu-card-1-title'],
    description: copy['about-wcu-card-1-desc']
  },
  {
    title: copy['about-wcu-card-2-title'],
    description: copy['about-wcu-card-2-desc']
  },
  {
    title: copy['about-wcu-card-3-title'],
    description: copy['about-wcu-card-3-desc']
  },
  {
    title: copy['about-wcu-card-4-title'],
    description: copy['about-wcu-card-4-desc']
  },
  {
    title: copy['about-wcu-card-5-title'],
    description: copy['about-wcu-card-5-desc']
  },
  {
    title: copy['about-wcu-card-6-title'],
    description: copy['about-wcu-card-6-desc']
  }
];

const milestones = [
  { year: copy['about-ms-1-yr'], text: copy['about-ms-1-desc'] },
  { year: copy['about-ms-2-yr'], text: copy['about-ms-2-desc'] },
  { year: copy['about-ms-3-yr'], text: copy['about-ms-3-desc'] },
  { year: copy['about-ms-4-yr'], text: copy['about-ms-4-desc'] }
];
---

<Layout
  title={copy['meta-about-title']}
  description={copy['meta-about-desc']}
>
  <!-- Hero Section -->
  <section class="relative w-full h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-r from-slate-950 via-slate-900 to-blue-950">
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 text-center text-white px-4 animate-on-scroll">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold font-serif tracking-tight">{copy['about-hero-title']}</h1>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center animate-on-scroll">
        <p class="text-xl text-gray-700 leading-relaxed max-w-5xl mx-auto">
          {copy['about-intro-p']}
        </p>
      </div>
    </div>
  </section>

  <!-- Our Values Section -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 font-serif">
          {copy['about-values-heading']}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {copy['about-values-sub']}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="bg-white border border-gray-300 rounded-xl p-8 hover:shadow-2xl hover:scale-105 transition-all duration-300 hover:-translate-y-1 animate-on-scroll">
            <h3 class="text-2xl font-bold text-blue-600 mb-2 font-serif">
              {value.title}
            </h3>
            <p class="text-lg font-semibold text-gray-800 mb-4">
              {value.tagline}
            </p>
            <p class="text-gray-600 leading-relaxed">
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 font-serif">
          {copy['about-what-we-do-title']}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {copy['about-what-we-do-sub']}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {capabilities.map((cap) => (
          <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-on-scroll flex flex-col">
            <div class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 mb-4 flex-shrink-0">
              <cap.icon class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3 font-serif">
              {cap.title}
            </h3>
            <p class="text-gray-600 leading-relaxed text-sm flex-grow">
              {cap.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 font-serif">
          {copy['about-why-choose-heading']}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {copy['about-why-choose-sub']}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {whyUsCards.map((card) => (
          <div class="bg-blue-50 rounded-xl p-8 border border-blue-100 animate-on-scroll hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-bold text-blue-600 mb-4 font-serif">{card.title}</h3>
            <p class="text-gray-700 leading-relaxed">
              {card.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Journey Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 font-serif">
          {copy['about-journey-heading']}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {copy['about-journey-sub']}
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Story Column -->
        <div class="animate-on-scroll">
          <h3 class="text-2xl font-bold text-gray-900 mb-6 font-serif">{copy['about-journey-story-heading']}</h3>
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>{copy['about-journey-story-p1']}</p>
            <p>{copy['about-journey-story-p2']}</p>
            <p>{copy['about-journey-story-p3']}</p>
          </div>
        </div>

        <!-- Milestones Column -->
        <div class="animate-on-scroll">
          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h4 class="text-xl font-bold text-blue-600 mb-6 font-serif">{copy['about-milestones-heading']}</h4>
            <div class="space-y-4">
              {milestones.map((m) => (
                <div class="flex items-start space-x-3">
                  <div class="w-3 h-3 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <div>
                    <h5 class="font-semibold text-gray-900">{m.year}</h5>
                    <p class="text-gray-600">{m.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Commitment to Excellence Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 font-serif">
          {copy['about-commit-heading']}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {copy['about-commit-sub']}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center animate-on-scroll">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-600">
            <Users class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2 font-serif">{copy['about-commit-p1-title']}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{copy['about-commit-p1-desc']}</p>
        </div>

        <div class="text-center animate-on-scroll">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-600">
            <Wrench class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2 font-serif">{copy['about-commit-p2-title']}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{copy['about-commit-p2-desc']}</p>
        </div>

        <div class="text-center animate-on-scroll">
          <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white">
            <ShieldCheck class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2 font-serif">{copy['about-commit-p3-title']}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{copy['about-commit-p3-desc']}</p>
        </div>

        <div class="text-center animate-on-scroll">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-600">
            <Factory class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2 font-serif">{copy['about-commit-p4-title']}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{copy['about-commit-p4-desc']}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder / Leadership Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Message box (45% / 5 cols) -->
        <div class="lg:col-span-5 bg-blue-600 rounded-2xl p-8 sm:p-12 text-white min-h-[500px] flex flex-col justify-center shadow-xl animate-on-scroll">
          <h3 class="text-3xl font-bold mb-6 font-serif">{copy['about-founder-heading']}</h3>
          <p class="text-base sm:text-lg leading-relaxed mb-8 text-blue-50 font-sans">
            {copy['about-founder-quote']}
          </p>
          <div>
            <h4 class="text-2xl font-bold font-serif">{copy['about-founder-name']}</h4>
            <p class="text-blue-200 mt-1">{copy['about-founder-role']}</p>
          </div>
        </div>

        <!-- Leadership Presentation Container (55% / 7 cols) -->
        <div class="lg:col-span-7 order-first lg:order-last animate-on-scroll">
          <div class="bg-gradient-to-tr from-slate-900 via-gray-900 to-blue-950 p-8 rounded-2xl h-[420px] lg:h-[600px] flex flex-col items-center justify-center overflow-hidden shadow-xl border border-gray-800 text-center relative group">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-600/10 via-transparent to-transparent"></div>
            <div class="z-10 space-y-4 max-w-md p-6">
              <div class="w-20 h-20 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto text-blue-400 shadow-inner">
                <Users class="w-10 h-10" />
              </div>
              <h3 class="font-serif text-2xl font-bold text-white tracking-wide">
                From Casting to Finished Product
              </h3>
              <p class="font-sans text-sm text-gray-400 leading-relaxed">
                Dedicated engineering and metallurgical leadership unifying pattern tooling, foundry casting, and CNC machining operations under one single-source manufacturing entity.
              </p>
              <div class="pt-4 flex items-center justify-center gap-6 text-xs text-blue-300 font-semibold tracking-wider uppercase">
                <span>Metallurgy</span>
                <span>•</span>
                <span>CNC Precision</span>
                <span>•</span>
                <span>Metrology QA</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
