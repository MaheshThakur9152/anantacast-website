---
import copy from '../data/copy';

const stats = [
  { number: copy['stat-1-num'], label: copy['stat-1-label'] },
  { number: copy['stat-2-num'], label: copy['stat-2-label'] },
  { number: copy['stat-3-num'], label: copy['stat-3-label'] },
  { number: copy['stat-4-num'], label: copy['stat-4-label'] }
];
---

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[45%_55%] gap-8 lg:gap-16 items-center">
      
      <!-- Right: Plant Visual Enclosure (First on mobile) -->
      <div class="relative w-full order-1 lg:order-2 animate-on-scroll">
        <div class="min-h-[220px] sm:h-64 md:h-80 lg:aspect-[16/9] rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-tr from-slate-950 via-gray-900 to-slate-800 border border-gray-800 relative flex">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/videos/3977979-hd_1920_1080_24fps-poster.jpg"
            class="w-full h-full object-cover"
          >
            <source src="/videos/3977979-hd_1920_1080_24fps.webm" type="video/webm" />
            <source src="/videos/3977979-hd_1920_1080_24fps.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
      
      <!-- Left: Text Content (Second on mobile) -->
      <div class="space-y-5 order-2 lg:order-1 animate-on-scroll">
        <!-- Heading -->
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">
          {copy['stats-heading']}
        </h2>
        
        <!-- Description -->
        <p class="font-sans text-sm md:text-base text-gray-600 leading-relaxed">
          {copy['stats-description']}
        </p>
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-x-4 sm:gap-x-8 gap-y-6 pt-4">
          {stats.map((stat) => (
            <div class="border-t-2 border-blue-600 pt-3 group">
              <div 
                class="stat-counter text-3xl sm:text-4xl md:text-5xl font-bold text-blue-600 mb-1 font-serif group-hover:translate-x-1 transition-transform duration-300"
                data-target={parseInt(stat.number.replace(/\D/g, '') || '0', 10)}
                data-suffix={stat.number.replace(/\d/g, '')}
              >
                {stat.number}
              </div>
              <div class="text-xs md:text-sm text-gray-900 font-medium leading-snug">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  function setupCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    // Respect user motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.getAttribute('data-target') || '0', 10);
          const suffix = el.getAttribute('data-suffix') || '';
          const duration = 1300; // ms
          const startTime = performance.now();

          el.textContent = `0${suffix}`;

          function animate(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Quartic ease-out for swift start and buttery soft landing
            const easeProgress = 1 - Math.pow(1 - progress, 4);
            const current = Math.floor(easeProgress * target);

            el.textContent = `${current}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(animate);
            } else {
              el.textContent = `${target}${suffix}`;
            }
          }

          requestAnimationFrame(animate);
          observer.unobserve(el);
        }
      });
    }, {
      threshold: 0.2,
      rootMargin: '0px 0px -40px 0px'
    });

    counters.forEach(c => observer.observe(c));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCounters);
  } else {
    setupCounters();
  }
</script>
