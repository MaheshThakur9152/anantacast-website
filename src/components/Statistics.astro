---
import copy from '../data/copy';

const stats = [
  { number: copy['stat-1-num'], label: copy['stat-1-label'] },
  { number: copy['stat-2-num'], label: copy['stat-2-label'] },
  { number: copy['stat-3-num'], label: copy['stat-3-label'] },
  { number: copy['stat-4-num'], label: copy['stat-4-label'] }
];
---

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[45%_55%] gap-8 lg:gap-16 items-center">
      
      <!-- Right: Plant Visual Enclosure (First on mobile) -->
      <div class="relative w-full order-1 lg:order-2 animate-on-scroll">
        <div class="min-h-[220px] sm:h-64 md:h-80 lg:aspect-[16/9] rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-tr from-slate-950 via-gray-900 to-slate-800 border border-gray-800 flex items-center justify-center relative group p-6">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent"></div>
          <div class="text-center z-10">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mx-auto mb-3 text-blue-400 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <p class="font-serif text-base sm:text-lg font-bold text-white tracking-wide">Integrated Casting Plant Operations</p>
            <p class="font-sans text-xs text-gray-400 mt-1 max-w-xs mx-auto">High-Pressure Die Casting & CNC Precision Facility</p>
          </div>
        </div>
      </div>
      
      <!-- Left: Text Content (Second on mobile) -->
      <div class="space-y-5 order-2 lg:order-1 animate-on-scroll">
        <!-- Heading -->
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">
          {copy['stats-heading']}
        </h2>
        
        <!-- Description -->
        <p class="font-sans text-sm md:text-base text-gray-600 leading-relaxed">
          {copy['stats-description']}
        </p>
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-x-4 sm:gap-x-8 gap-y-6 pt-4">
          {stats.map((stat) => (
            <div class="border-t-2 border-blue-600 pt-3 group">
              <div class="text-3xl sm:text-4xl md:text-5xl font-bold text-blue-600 mb-1 font-serif group-hover:translate-x-1 transition-transform duration-300">{stat.number}</div>
              <div class="text-xs md:text-sm text-gray-900 font-medium leading-snug">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</section>
