---
import copy from '../data/copy';

const usps = [
  {
    number: copy['why-card-1-num'],
    title: copy['why-card-1-title'],
    description: copy['why-card-1-desc']
  },
  {
    number: copy['why-card-2-num'],
    title: copy['why-card-2-title'],
    description: copy['why-card-2-desc']
  },
  {
    number: copy['why-card-3-num'],
    title: copy['why-card-3-title'],
    description: copy['why-card-3-desc']
  },
  {
    number: copy['why-card-4-num'],
    title: copy['why-card-4-title'],
    description: copy['why-card-4-desc']
  },
  {
    number: copy['why-card-5-num'],
    title: copy['why-card-5-title'],
    description: copy['why-card-5-desc']
  },
  {
    number: copy['why-card-6-num'],
    title: copy['why-card-6-title'],
    description: copy['why-card-6-desc']
  }
];
---

<section id="why-anantacast" class="py-20 bg-gray-50 scroll-mt-20">
  <div id="why-ambe-service" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {copy['why-heading']}
      </h2>
      <p class="font-sans text-lg text-gray-600 max-w-3xl mx-auto">
        {copy['why-subtitle']}
      </p>
    </div>

    <!-- USP Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {usps.map((usp) => (
        <div class="animate-on-scroll">
          <div class="group hover:border-blue-500 transition-all duration-300 border-2 border-gray-200 bg-white p-6 h-full hover:shadow-lg rounded-xl flex flex-col gap-4">
            <div class="font-serif text-4xl font-bold text-blue-600 opacity-50">
              {usp.number}
            </div>
            <div>
              <h3 class="font-serif text-xl md:text-2xl font-semibold text-gray-900 mb-2">
                {usp.title}
              </h3>
              <p class="font-sans text-gray-600 leading-relaxed">
                {usp.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
