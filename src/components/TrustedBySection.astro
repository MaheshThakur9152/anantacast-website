---
import copy from '../data/copy';

const industrySectors = [
  'Automotive Powertrains',
  'Hydraulic Assemblies',
  'Industrial Valves',
  'Pump Components',
  'Power Transmission',
  'Heavy Machinery',
  'Electrical Enclosures',
  'Energy Equipment',
  'Fluid Systems',
  'Railway Components',
  'Material Handling',
  'Agricultural Equipment'
];
---

<section class="py-10 md:py-14 bg-white border-t border-gray-100 overflow-hidden" aria-label="Trusted Manufacturing Sectors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-6 md:mb-8 animate-on-scroll">
      <h2 class="font-serif text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
        {copy['trusted-heading']}
      </h2>
    </div>
    
    <!-- Ticker Container with gradient fades -->
    <div class="relative w-full overflow-hidden" role="region" aria-live="off">
      <!-- Gradient Fades on edges -->
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-r from-white to-transparent z-10"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-l from-white to-transparent z-10"></div>

      <!-- Pure Hardware-Accelerated CSS Infinite Marquee -->
      <div class="ticker-track flex w-max py-2">
        <div class="ticker-content flex items-center gap-4 sm:gap-6 md:gap-8 flex-shrink-0 pr-4 sm:pr-6 md:pr-8">
          {industrySectors.map((sector) => (
            <div class="flex-shrink-0 flex items-center justify-center">
              <div class="px-4 sm:px-6 py-2.5 sm:py-3.5 border border-gray-200/80 rounded-xl bg-gray-50/70 hover:bg-blue-50/60 hover:border-blue-400 text-gray-700 hover:text-blue-700 font-semibold text-xs sm:text-sm tracking-wide text-center transition-all duration-300 shadow-xs hover:shadow-sm select-none">
                {sector}
              </div>
            </div>
          ))}
        </div>
        <div class="ticker-content flex items-center gap-4 sm:gap-6 md:gap-8 flex-shrink-0 pr-4 sm:pr-6 md:pr-8" aria-hidden="true">
          {industrySectors.map((sector) => (
            <div class="flex-shrink-0 flex items-center justify-center">
              <div class="px-4 sm:px-6 py-2.5 sm:py-3.5 border border-gray-200/80 rounded-xl bg-gray-50/70 hover:bg-blue-50/60 hover:border-blue-400 text-gray-700 hover:text-blue-700 font-semibold text-xs sm:text-sm tracking-wide text-center transition-all duration-300 shadow-xs hover:shadow-sm select-none">
                {sector}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ticker-track {
    animation: ticker-slide 30s linear infinite;
    will-change: transform;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes ticker-slide {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 640px) {
    .ticker-track {
      animation-duration: 22s;
    }
  }
</style>
