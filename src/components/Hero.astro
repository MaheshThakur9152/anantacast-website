---
import copy from '../data/copy';
---

<section id="home" class="relative w-full h-[280px] sm:h-[340px] md:h-[450px] overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950">
  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/50 to-black/30 z-5"></div>

  <!-- Content - Bottom left aligned -->
  <div class="absolute inset-0 z-10 flex items-end pb-8 sm:pb-12">
    <div class="container mx-auto px-4 sm:px-8 md:px-16 lg:px-24 max-w-7xl">
      <div class="max-w-3xl">
        <div class="animate-on-scroll">
          <a
            href="#services"
            role="button"
            class="inline-block bg-white text-black px-6 sm:px-8 py-2.5 sm:py-3 rounded-full font-sans font-medium hover:bg-gray-100 transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-lg text-sm sm:text-base"
          >
            {copy['hero-cta']}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
