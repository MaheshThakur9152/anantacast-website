---
import { HardHat, ShieldCheck, Truck, DraftingCompass } from 'lucide-astro';
import copy from '../data/copy';

const peopleFeatures = [
  {
    title: copy['people-card-1-title'],
    description: copy['people-card-1-desc'],
    icon: HardHat
  },
  {
    title: copy['people-card-2-title'],
    description: copy['people-card-2-desc'],
    icon: ShieldCheck
  },
  {
    title: copy['people-card-3-title'],
    description: copy['people-card-3-desc'],
    icon: Truck
  },
  {
    title: copy['people-card-4-title'],
    description: copy['people-card-4-desc'],
    icon: DraftingCompass
  }
];
---

<section class="py-12 md:py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    
    <!-- Centered Heading -->
    <div class="text-center mb-10 animate-on-scroll">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-3 border-b-2 border-gray-900 pb-3 inline-block">
        {copy['people-heading']}
      </h2>
      <p class="font-sans text-sm md:text-base text-gray-600 mt-4 max-w-2xl mx-auto">
        {copy['people-description']}
      </p>
    </div>
    
    <!-- 4-Card Grid with Consistent Heights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 auto-rows-fr">
      {peopleFeatures.map((feature) => (
        <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col h-full border border-gray-100 animate-on-scroll">
          <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center mb-4 flex-shrink-0 text-white shadow-xs">
            <feature.icon class="w-6 h-6" />
          </div>
          <h3 class="font-serif text-base md:text-lg font-semibold text-gray-900 mb-2">
            {feature.title}
          </h3>
          <p class="font-sans text-xs md:text-sm text-gray-600 leading-relaxed flex-grow">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
    
  </div>
</section>
