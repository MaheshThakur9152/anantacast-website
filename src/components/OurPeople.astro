---
import copy from '../data/copy';

const peopleFeatures = [
  {
    title: copy['people-card-1-title'],
    description: copy['people-card-1-desc'],
    icon: `<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  {
    title: copy['people-card-2-title'],
    description: copy['people-card-2-desc'],
    icon: `<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  {
    title: copy['people-card-3-title'],
    description: copy['people-card-3-desc'],
    icon: `<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  },
  {
    title: copy['people-card-4-title'],
    description: copy['people-card-4-desc'],
    icon: `<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  }
];
---

<section class="py-12 md:py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    
    <!-- Centered Heading -->
    <div class="text-center mb-10 animate-on-scroll">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-3 border-b-2 border-gray-900 pb-3 inline-block">
        {copy['people-heading']}
      </h2>
      <p class="font-sans text-sm md:text-base text-gray-600 mt-4 max-w-2xl mx-auto">
        {copy['people-description']}
      </p>
    </div>
    
    <!-- 4-Card Grid with Consistent Heights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 auto-rows-fr">
      {peopleFeatures.map((feature) => (
        <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col h-full border border-gray-100 animate-on-scroll">
          <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center mb-4 flex-shrink-0 text-white shadow-xs" set:html={feature.icon}>
          </div>
          <h3 class="font-serif text-base md:text-lg font-semibold text-gray-900 mb-2">
            {feature.title}
          </h3>
          <p class="font-sans text-xs md:text-sm text-gray-600 leading-relaxed flex-grow">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
    
  </div>
</section>
