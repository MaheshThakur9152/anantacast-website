---
import { Star, ShieldCheck } from 'lucide-astro';
import copy from '../data/copy';

const testimonials = [
  {
    name: copy['test-1-name'],
    role: copy['test-1-role'],
    review: copy['test-1-review']
  },
  {
    name: copy['test-2-name'],
    role: copy['test-2-role'],
    review: copy['test-2-review']
  },
  {
    name: copy['test-3-name'],
    role: copy['test-3-role'],
    review: copy['test-3-review']
  },
  {
    name: copy['test-4-name'],
    role: copy['test-4-role'],
    review: copy['test-4-review']
  },
  {
    name: copy['test-5-name'],
    role: copy['test-5-role'],
    review: copy['test-5-review']
  }
];
---

<section id="testimonials" class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      
      <!-- Left: Content Carousel -->
      <div class="animate-on-scroll">
        <p class="font-sans text-sm text-gray-600 mb-3 font-medium tracking-wide uppercase">{copy['test-eyebrow']}</p>
        
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 border-b-2 border-gray-900 pb-4 inline-block leading-tight">
          Over <span class="text-orange-500">100+</span> manufacturers have trusted us for precision cast component requirements
        </h2>
        
        <div id="testimonial-container" class="relative min-h-[160px] sm:min-h-[140px]">
          {testimonials.map((t, idx) => (
            <div
              class={`testimonial-slide transition-all duration-500 ease-out ${
                idx === 0 
                  ? 'opacity-100 translate-y-0 relative z-10 pointer-events-auto' 
                  : 'opacity-0 translate-y-3 absolute inset-0 z-0 pointer-events-none'
              }`}
              data-index={idx}
            >
              <p class="font-sans text-sm sm:text-base text-gray-700 leading-relaxed mb-6 italic">
                "{t.review}"
              </p>
              
              <div class="mb-4">
                <h4 class="font-serif text-base sm:text-lg font-bold text-gray-900">
                  {t.name}
                </h4>
                <p class="font-sans text-xs sm:text-sm text-gray-600">
                  {t.role}
                </p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Dot Navigation -->
        <div class="flex items-center gap-2 mt-6">
          {testimonials.map((_, idx) => (
            <button
              class={`testimonial-dot h-2.5 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-blue-600 w-8' : 'bg-gray-300 w-2.5 hover:bg-gray-400'}`}
              data-index={idx}
              aria-label={`Go to testimonial ${idx + 1}`}
            ></button>
          ))}
        </div>
      </div>
      
      <!-- Right: Visual Container with Reviews Badge -->
      <div class="relative animate-on-scroll">
        <div class="relative rounded-2xl w-full min-h-[300px] sm:aspect-[4/3] bg-gradient-to-br from-slate-900 via-gray-900 to-slate-800 border border-gray-700 shadow-2xl overflow-hidden flex flex-col items-center justify-center p-6 sm:p-8">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-blue-900/30 via-transparent to-transparent"></div>
          
          <div class="text-center z-10 space-y-3 max-w-sm mb-4 sm:mb-0">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto text-blue-400">
              <ShieldCheck class="w-7 h-7 sm:w-8 sm:h-8" />
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white">Tier-1 OEM Quality Approved</h3>
            <p class="font-sans text-xs text-gray-400 leading-relaxed">
              Consistently verified across automotive, hydraulic, and industrial equipment audits for dimensional compliance and zero defects.
            </p>
          </div>
          
          <!-- Reviews Badge -->
          <div class="static sm:absolute sm:top-5 sm:right-5 bg-gray-800/95 backdrop-blur-sm text-white rounded-2xl p-3.5 sm:p-4 shadow-2xl border border-gray-700/60 z-20 w-full max-w-[200px] sm:w-auto">
            <div class="text-xl sm:text-2xl font-bold mb-1 font-serif">{copy['test-badge-score']}</div>
            <div class="flex gap-0.5 mb-2">
              <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
              <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
              <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
              <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
              <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
            </div>
            <div class="text-xs sm:text-sm font-semibold">{copy['test-badge-count']}</div>
            <a
              href="/contact"
              class="mt-3 block w-full bg-orange-500 hover:bg-orange-600 text-white py-2 px-3 sm:px-4 rounded-lg text-xs sm:text-sm font-medium transition-colors text-center active:scale-95"
            >
              {copy['test-badge-cta']}
            </a>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  function setupTestimonials() {
    const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
    const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
    if (!slides.length) return;

    let currentIndex = 0;
    const total = slides.length;
    let autoPlayInterval: any = null;

    function showSlide(index: number) {
      slides.forEach((s, idx) => {
        if (idx === index) {
          s.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none', 'absolute');
          s.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto', 'relative', 'z-10');
        } else {
          s.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto', 'relative', 'z-10');
          s.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none', 'absolute', 'inset-0');
        }
      });

      dots.forEach((d, idx) => {
        if (idx === index) {
          d.classList.add('bg-blue-600', 'w-8');
          d.classList.remove('bg-gray-300', 'w-2.5');
        } else {
          d.classList.remove('bg-blue-600', 'w-8');
          d.classList.add('bg-gray-300', 'w-2.5');
        }
      });
      currentIndex = index;
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        showSlide(idx);
        restartTimer();
      });
    });

    function startTimer() {
      autoPlayInterval = setInterval(() => {
        showSlide((currentIndex + 1) % total);
      }, 5000);
    }

    function restartTimer() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
      startTimer();
    }

    startTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTestimonials);
  } else {
    setupTestimonials();
  }
</script>
