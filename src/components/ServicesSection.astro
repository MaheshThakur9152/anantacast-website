---
import { 
  DraftingCompass, 
  Flame, 
  Cog, 
  ThermometerSun,
  Disc,
  CircleGauge,
  Anvil,
  Wrench,
  Component,
  Microscope,
  Cpu,
  ShieldCheck,
  ChevronDown
} from 'lucide-astro';
import copy from '../data/copy';

const services = [
  {
    icon: DraftingCompass,
    title: copy['service-card-1-title'],
    description: copy['service-card-1-desc'],
    slug: 'patternmaking',
    image: '/images/foundry_casting.webp',
    imageAlt: 'High-tolerance patternmaking and tooling'
  },
  {
    icon: Flame,
    title: copy['service-card-2-title'],
    description: copy['service-card-2-desc'],
    slug: 'casting',
    image: '/images/pouring-molten-metal-into-molds-during-a-foundry-casting-process-photo.webp',
    imageAlt: 'Foundry casting and molten metal pouring'
  },
  {
    icon: Cog,
    title: copy['service-card-3-title'],
    description: copy['service-card-3-desc'],
    slug: 'machining',
    video: {
      webm: '/videos/Precision_Machining.webm',
      mp4: '/videos/Precision_Machining.mp4',
      poster: '/videos/Precision_Machining-poster.jpg'
    }
  },
  {
    icon: ThermometerSun,
    title: copy['service-card-4-title'],
    description: copy['service-card-4-desc'],
    slug: 'heat-treatment',
    video: {
      webm: '/videos/Heat_Treatment_Conditioning.webm',
      mp4: '/videos/Heat_Treatment_Conditioning.mp4',
      poster: '/videos/Heat_Treatment_Conditioning-poster.jpg'
    }
  },
  {
    icon: Disc,
    title: copy['service-card-5-title'],
    description: copy['service-card-5-desc'],
    slug: 'finishing',
    video: {
      webm: '/videos/Surface_Finishing.webm',
      mp4: '/videos/Surface_Finishing.mp4',
      poster: '/videos/Surface_Finishing-poster.jpg'
    }
  },
  {
    icon: CircleGauge,
    title: copy['service-card-6-title'],
    description: copy['service-card-6-desc'],
    slug: 'metrology',
    video: {
      webm: '/videos/Quality_Metrology.webm',
      mp4: '/videos/Quality_Metrology.mp4',
      poster: '/videos/Quality_Metrology-poster.jpg'
    }
  },
  {
    icon: Anvil,
    title: copy['service-card-7-title'],
    description: copy['service-card-7-desc'],
    slug: 'alloys'
  },
  {
    icon: Wrench,
    title: copy['service-card-8-title'],
    description: copy['service-card-8-desc'],
    slug: 'tooling'
  },
  {
    icon: Component,
    title: copy['service-card-9-title'],
    description: copy['service-card-9-desc'],
    slug: 'assembly'
  },
  {
    icon: Microscope,
    title: copy['service-card-10-title'],
    description: copy['service-card-10-desc'],
    slug: 'testing'
  },
  {
    icon: Cpu,
    title: copy['service-card-11-title'],
    description: copy['service-card-11-desc'],
    slug: 'dfm'
  },
  {
    icon: ShieldCheck,
    title: copy['service-card-12-title'],
    description: copy['service-card-12-desc'],
    slug: 'coating'
  }
];
---

<section id="services" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16 animate-on-scroll">
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 tracking-tight">
        {copy['services-heading']}
      </h2>
      <p class="font-sans text-base sm:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        {copy['services-subtitle']}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {services.map((service, index) => (
        <div
          class={`service-card group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 border border-gray-100 animate-on-scroll ${
            index >= 6 ? 'hidden extra-service' : ''
          }`}
          data-index={index}
        >
          <!-- Media Area -->
          <div class="relative h-44 sm:h-56 overflow-hidden bg-gradient-to-br from-slate-100 via-gray-100 to-slate-200 border-b border-gray-100 flex items-center justify-center">
            {service.video ? (
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={service.video.poster}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              >
                <source src={service.video.webm} type="video/webm" />
                <source src={service.video.mp4} type="video/mp4" />
              </video>
            ) : service.image ? (
              <img
                src={service.image}
                alt={service.imageAlt || service.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
            ) : (
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white/90 backdrop-blur-sm border border-gray-200/60 shadow-sm flex items-center justify-center text-blue-600 group-hover:scale-110 transition-transform duration-300">
                <service.icon class="w-7 h-7 sm:w-8 sm:h-8" />
              </div>
            )}
          </div>
          
          <!-- Card Content -->
          <div class="p-5 sm:p-6">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4 text-blue-600">
              <service.icon class="w-5 h-5 sm:w-6 sm:h-6" />
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3">
              {service.title}
            </h3>
            <p class="font-sans text-xs sm:text-sm text-gray-600 leading-relaxed">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- View More Button -->
    <div class="flex justify-center mt-10 sm:mt-12">
      <button
        id="toggle-services-btn"
        class="bg-blue-600 hover:bg-blue-700 text-white px-7 sm:px-8 py-3 rounded-xl font-sans font-semibold transition-all duration-300 hover:shadow-lg flex items-center gap-2 transform hover:scale-105 active:scale-95 text-sm sm:text-base cursor-pointer"
      >
        <span id="btn-text">{copy['services-view-more-btn']}</span>
        <ChevronDown id="btn-icon" class="h-5 w-5 transition-transform duration-300" />
      </button>
    </div>
  </div>
</section>

<script>
  function setupServices() {
    // 1. Toggle extra services
    const btn = document.getElementById('toggle-services-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const extraCards = document.querySelectorAll('.extra-service');

    if (btn && btnText && btnIcon) {
      let isExpanded = false;

      btn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        extraCards.forEach(card => {
          if (isExpanded) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        if (isExpanded) {
          btnText.textContent = 'Show Less';
          btnIcon.classList.add('rotate-180');
        } else {
          btnText.textContent = 'View More Capabilities';
          btnIcon.classList.remove('rotate-180');
        }
      });
    }

    // 2. Viewport-aware video autoplay / pause
    const cardVideos = document.querySelectorAll<HTMLVideoElement>('#services video');
    if (cardVideos.length && 'IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.15 });

      cardVideos.forEach(v => videoObserver.observe(v));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupServices);
  } else {
    setupServices();
  }
</script>
