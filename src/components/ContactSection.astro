---
import { Phone, Mail, MapPin, Clock, Send } from 'lucide-astro';
import copy from '../data/copy';

const services = [
  copy['service-card-1-title'],
  copy['service-card-2-title'],
  copy['service-card-3-title'],
  copy['service-card-4-title'],
  copy['service-card-5-title'],
  copy['service-card-6-title'],
  copy['service-card-7-title'],
  copy['service-card-8-title'],
  copy['service-card-9-title'],
  copy['service-card-10-title'],
  copy['service-card-11-title'],
  copy['service-card-12-title']
];
---

<section id="contact" class="py-20 bg-gray-50 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">{copy['contact-home-heading']}</h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">{copy['contact-home-subtitle']}</p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Form Column -->
      <div class="bg-white rounded-2xl p-8 shadow-lg animate-on-scroll">
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-8">{copy['contact-home-form-title']}</h2>
        
        <form id="home-contact-form" class="space-y-6">
          <div>
            <label for="home-name" class="block text-sm font-medium text-gray-700 mb-2">{copy['contact-home-name-label']}</label>
            <input 
              type="text" 
              id="home-name" 
              name="name" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" 
              placeholder={copy['contact-home-name-ph']} 
            />
            <p id="home-name-err" class="mt-1 text-sm text-red-500 hidden">Name is required</p>
          </div>

          <div>
            <label for="home-phone" class="block text-sm font-medium text-gray-700 mb-2">{copy['contact-home-phone-label']}</label>
            <input 
              type="tel" 
              id="home-phone" 
              name="phone" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" 
              placeholder={copy['contact-home-phone-ph']} 
            />
            <p id="home-phone-err" class="mt-1 text-sm text-red-500 hidden">Please enter a valid phone number</p>
          </div>

          <div>
            <label for="home-service" class="block text-sm font-medium text-gray-700 mb-2">{copy['contact-home-service-label']}</label>
            <select 
              id="home-service" 
              name="service" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            >
              <option value="">{copy['contact-home-service-ph']}</option>
              {services.map((service) => (<option value={service}>{service}</option>))}
            </select>
            <p id="home-service-err" class="mt-1 text-sm text-red-500 hidden">Please select a manufacturing process</p>
          </div>

          <div>
            <label for="home-message" class="block text-sm font-medium text-gray-700 mb-2">{copy['contact-home-msg-label']}</label>
            <textarea 
              id="home-message" 
              name="message" 
              rows={4} 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" 
              placeholder={copy['contact-home-msg-ph']}
            ></textarea>
            <p id="home-message-err" class="mt-1 text-sm text-red-500 hidden">Message specifications are required</p>
          </div>

          <button 
            type="submit" 
            id="home-submit-btn"
            class="w-full bg-blue-600 text-white py-4 px-6 rounded-lg font-medium hover:bg-blue-700 transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed flex items-center justify-center gap-2 cursor-pointer shadow-md"
          >
            <span id="home-submit-text">{copy['contact-home-btn-submit']}</span>
            <Send class="w-5 h-5" />
          </button>

          <div id="home-submit-feedback" class="hidden bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm">
            {copy['contact-home-success-msg']}
          </div>
        </form>
      </div>

      <!-- Info Column -->
      <div class="bg-white rounded-2xl p-8 shadow-lg animate-on-scroll">
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-8">{copy['contact-home-info-title']}</h2>
        
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <Phone class="w-6 h-6 text-blue-600" />
          </div>
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900 mb-2">{copy['contact-home-phone-title']}</h3>
            <p class="text-gray-600">+91 9619607537</p>
            <p class="text-gray-600">+91 7977018742</p>
            <p class="text-gray-600">022 4506 6566</p>
          </div>
        </div>
        
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <Mail class="w-6 h-6 text-blue-600" />
          </div>
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900 mb-2">{copy['contact-home-email-title']}</h3>
            <a href={`mailto:${copy['contact-home-email-val']}`} class="text-blue-600 hover:underline">
              {copy['contact-home-email-val']}
            </a>
          </div>
        </div>
        
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <MapPin class="w-6 h-6 text-blue-600" />
          </div>
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900 mb-2">{copy['contact-home-addr-title']}</h3>
            <p class="text-gray-600 leading-relaxed">
              {copy['contact-home-addr-val']}
            </p>
          </div>
        </div>
        
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <Clock class="w-6 h-6 text-blue-600" />
          </div>
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900 mb-2">{copy['contact-home-hours-title']}</h3>
            <p class="text-gray-600">{copy['contact-home-hours-val-1']}</p>
            <p class="text-gray-600">{copy['contact-home-hours-val-2']}</p>
            <p class="text-blue-600 font-medium mt-2">{copy['contact-home-hours-val-3']}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupHomeContactForm() {
    const form = document.getElementById('home-contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('home-submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('home-submit-text');
    const feedback = document.getElementById('home-submit-feedback');

    if (!form || !submitBtn || !feedback || !submitText) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitText.textContent = 'Sending...';

      setTimeout(() => {
        submitBtn.disabled = false;
        submitText.textContent = 'Submit RFQ';
        feedback.classList.remove('hidden');
        form.reset();

        setTimeout(() => {
          feedback.classList.add('hidden');
        }, 5000);
      }, 1000);
    });
  }

  document.addEventListener('DOMContentLoaded', setupHomeContactForm);
</script>
